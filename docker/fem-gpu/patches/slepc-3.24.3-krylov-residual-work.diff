diff --git a/src/eps/impls/krylov/epskrylov.c b/src/eps/impls/krylov/epskrylov.c
--- a/src/eps/impls/krylov/epskrylov.c
+++ b/src/eps/impls/krylov/epskrylov.c
@@ -188,6 +188,35 @@
   PetscFunctionReturn(PETSC_SUCCESS);
 }

+PetscErrorCode EPSKrylovSetUpResidualWork(EPS eps)
+{
+  PetscInt       i;
+  Vec            workspace;
+
+  PetscFunctionBegin;
+  for (i=0;i<5;i++) {
+#if defined(PETSC_USE_COMPLEX)
+    if (i==3) continue; /* no imaginary residual work vector */
+#endif
+    if (!eps->krylov_residual_work[i]) {
+      PetscCall(BVCreateVec(eps->V,&workspace));
+      eps->krylov_residual_work[i] = workspace;
+      /* Materialize device storage before using the vector in convergence. */
+      PetscCall(VecSet(workspace,0.0));
+    }
+  }
+  PetscFunctionReturn(PETSC_SUCCESS);
+}
+
+PetscErrorCode EPSKrylovResetResidualWork(EPS eps)
+{
+  PetscInt       i;
+
+  PetscFunctionBegin;
+  for (i=0;i<5;i++) PetscCall(VecDestroy(&eps->krylov_residual_work[i]));
+  PetscFunctionReturn(PETSC_SUCCESS);
+}
+
