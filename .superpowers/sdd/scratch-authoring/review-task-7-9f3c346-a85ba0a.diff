+          className.includes("transition-opacity") ||
+          (element.getAttribute("style") ?? "").includes("opacity");
+      }).length).toBe(0);
+    } catch (error) {
+      throw new Error(
+        `Stability failure after ${milestone}: ${error instanceof Error ? error.stack ?? error.message : String(error)}`,
