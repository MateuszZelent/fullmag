+      await act(async () => button(container, "Refresh scene").click());
+      mocks.scene.data = {
+        materials: [{ id: "mat:free-layer", name: "Free layer material" }],
+        objects: [{ id: "object-7", material_ref: null, name: "Free layer" }],
