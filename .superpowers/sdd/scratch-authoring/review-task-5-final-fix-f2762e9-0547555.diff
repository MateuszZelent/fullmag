 function findButton(root: TestNode, text: string): TestElement {
   const button = findElements(root, (element) =>
     element.tagName === "BUTTON" && element.textContent.includes(text))[0];
   if (!button) throw new Error(`Missing button ${text}`);
   return button;
 }
 
