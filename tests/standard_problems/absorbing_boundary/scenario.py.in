"""Exchange-wave packet at normal incidence, generated by prepare.py."""
from pathlib import Path
import fullmag as fm

# %% Device and geometry
study = fm.study("@CASE@")
study.engine("@ENGINE@")
study.device("@DEVICE@", precision="double")
study.mode("strict")
film = study.geometry(fm.Box(size=(1280e-9, 4e-9, 4e-9), name="film"), name="film")
@MESH@

# %% Matched equilibrium, wave packet and boundary
film.Ms = 800e3
film.Aex = 13e-12
film.alpha = 0.001
film.m.loadfile(Path(__file__).with_name("packet.json"), format="json")
@BOUNDARY@
study.exchange()
study.demag(enabled=False)
study.b_ext(0.05, 0.0, 0.0)

# %% Two transverse components suffice to measure the travelling envelope
dt = 2.0**-45
study.solver(integrator="rk4", fix_dt=dt, gamma=2.211e5)
run = study.stages.add_run(stage_id="propagate", until=65536 * dt)
run.autosave(fm.StageAutosave(
    fields=[fm.FieldAutosave("m", every=128 * dt)],
))
