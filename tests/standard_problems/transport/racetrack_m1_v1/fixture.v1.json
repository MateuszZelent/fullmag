    },
    {
      "id": "benchmark_grid",
      "kind": "explicit_fixture_motivation",
      "use": "The 256 x 64 x 4 structured grid exactly represents both layers and resolves the 1 nm FM thickness while remaining bounded for the first CUDA qualification workload."
    },
    {
      "id": "symmetric_drive_sweep",
      "kind": "explicit_fixture_motivation",
      "use": "Three nonzero magnitudes in both signs expose odd/even sign errors and support a signed-current Hall-angle regression without claiming a material-specific operating window."
    },
    {
      "id": "interface_branch_coverage",
      "kind": "explicit_fixture_motivation",
      "use": "Finite longitudinal, real-mixing, and imaginary-mixing coefficients exercise every M1 interface branch; the values are benchmark coefficients, not an interface fit."
    }
