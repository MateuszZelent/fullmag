// 500 nm x 500 nm x 10 nm Py layer, no PBC, matched to fullmag_case.py.
// Only scalar table values are recorded; no magnetization field is saved.

fcut := 10e9
t0 := 20 / fcut

SetGridSize(200, 200, 1)
SetCellSize(2.5e-9, 2.5e-9, 10e-9)
SetPBC(0, 0, 0)

Msat = 800e3
Aex = 13e-12
alpha = 0.01
Temp = 0
m = uniform(1, 0, 0)

// The built-in MuMax sinc is sin(x)/x, matching Fullmag's normalized sinc.
B_ext = vector(100e-3, 1e-3*sinc(2*pi*fcut*(t-t0)), 0)
// MuMax3 uses gamma in rad/(T*s); Fullmag uses mu0*gamma in m/(A*s).
GammaLL = 2.211e5/(4*pi*1e-7)
SetSolver(5)
MinDt = 1e-15
MaxDt = 2e-12
MaxErr = 1e-7

// Start the dynamic benchmark directly from the declared uniform state.
tableadd(E_exch)
tableadd(E_demag)
tableadd(E_zeeman)
tableadd(E_anis)
tableadd(E_total)
tableautosave(1/(2*1.3*fcut))
run(40/fcut)
