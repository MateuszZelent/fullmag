POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=fullmag
MINIO_ROOT_PASSWORD=change-me-minio
RUST_LOG=info

# Host-local configuration in the MAIN checkout's .env, shared by its worktrees.
# Set an absolute path for this Windows or Linux host before building.
# No variable interpolation or shell commands; process environment takes precedence.
# A custom root still requires the approved project marker and storage validation.
FULLMAG_PROJECT_STORAGE_ROOT=
# Operator preference for the direct development device boundary. `auto`
# selects CPU when the bounded host NVIDIA proof is unavailable; `required`
# fails closed and `disabled` selects the native CPU profile without probing.
FULLMAG_GPU_ACCESS=auto
# Defaults for direct Docker DEV. Explicit arguments/process settings override
# these values; running from a registered worktree selects that worktree.
# The setup wizard writes these values and a compatibility host-settings record.
FULLMAG_SOURCE_ROOT=
# Preferred frontend port. Without an explicit `just docker-dev` port a new
# group takes the next free loopback port; an existing group keeps its own.
FULLMAG_HTTP_PORT=
# Static budget of EACH Docker DEV group (whole numbers). Unset values derive
# from the Docker VM so three groups fit side by side: backend min(8, CPUs/4)
# CPUs and min(32, RAM/6) GiB, frontend min(4, CPUs/10) CPUs and 8-16 GiB.
# Limits are caps, not reservations; Cargo jobs follow the backend CPUs.
# FULLMAG_DEV_BACKEND_CPUS=8
# FULLMAG_DEV_BACKEND_MEMORY_GIB=32
# FULLMAG_DEV_FRONTEND_CPUS=4
# FULLMAG_DEV_FRONTEND_MEMORY_GIB=16
# Optional per-host toolchain settings. Use CUDA versions/architectures supported
# by this host's GPU. Compose reads these values from the main checkout .env.
# Without the three *_ARCHITECTURES values the DEV toolchain build targets the
# host GPUs reported by nvidia-smi (e.g. 89-real); FULLMAG_DEV_CUDA_ARCHITECTURES=all
# keeps the portable image matrix. Release and CI recipes keep the full matrix.
# FULLMAG_CUDA_BASE_IMAGE=<registry-reference>@sha256:<digest>
# FULLMAG_CUDA_BASE_IMAGE_DIGEST=<digest>
# FULLMAG_CUDA_ARCHITECTURES=<CMake architecture list>
# FULLMAG_HYPRE_GPU_ARCHITECTURES=<HYPRE architecture list>
# FULLMAG_PETSC_CUDA_ARCHITECTURES=<comma-separated architecture list>
# Bound memory-intensive MFEM CUDA compilation independently of CPU count.
FULLMAG_MFEM_BUILD_JOBS=1
# Optional MFEM GPU compile-time/runtime optimization tradeoff: 0|min|mid|max.
# Nonzero levels require NVCC with --Ofast-compile support (CUDA 12.9+).
FULLMAG_MFEM_CUDA_FAST_COMPILE=0
# Optional Windows-only disposable compiler mirror and compiler TEMP/TMP.
# Absolute local RAM-disk directory, outside durable storage and checkouts.
# Cargo target/cache, sealed snapshots, artifacts and runtime stay durable.
FULLMAG_WINDOWS_VOLATILE_ROOT=

# Optional explicit write grant for results and .fms beside scripts.
# Select one existing child of the source checkout; the checkout root is refused.
# The backend can write other files in this directory. Leave unset for readonly sources.
# FULLMAG_SCRIPT_OUTPUT_DIRECTORY=examples
