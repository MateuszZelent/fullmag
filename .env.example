POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=fullmag
MINIO_ROOT_PASSWORD=change-me-minio
RUST_LOG=info

# Host-local configuration in the MAIN checkout's .env, shared by its worktrees.
# Set an absolute path for this Windows or Linux host before building.
# No variable interpolation or shell commands; process environment takes precedence.
# A custom root still requires the approved project marker and storage validation.
FULLMAG_PROJECT_STORAGE_ROOT=

# Optional enrolled root for disposable BUILD scratch (e.g. a host RAM disk).
# Durable source capsules, results, receipts, caches of downloaded dependencies,
# runtime packages and active UI dependencies stay in PROJECT_STORAGE_ROOT.
# Register through fullmag_storage.py register-scratch before setting this key.
# No automatic fallback when the configured scratch disk is unavailable.
FULLMAG_PROJECT_SCRATCH_ROOT=
