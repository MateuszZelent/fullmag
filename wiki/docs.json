{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Fullmag Wiki",
  "colors": {
    "primary": "#0F766E",
    "light": "#14B8A6",
    "dark": "#134E4A"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Project docs",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Docs conventions",
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Writing docs",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "AI tooling",
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Core API",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Repo",
          "href": "https://github.com/kkingstoun/fullmag",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Issues",
          "href": "https://github.com/kkingstoun/fullmag/issues",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Repository",
        "href": "https://github.com/kkingstoun/fullmag"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open docs",
      "href": "/"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/kkingstoun/fullmag"
    }
  }
}
