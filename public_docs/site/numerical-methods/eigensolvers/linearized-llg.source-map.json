      {"python": "FemEigenSolverPolicy.tolerance", "type": "float", "default": "1e-8", "si_unit": "$1$", "validation": "finite float $> 0$", "meaning": "relative coupled eigenpair residual tolerance", "backend_support": "FEM modal lane", "problem_ir": "`study.fem_solver_policy.tolerance`"},
