      {"python": "FemEigenSolverPolicy.target_spectrum", "type": "str", "default": "smallest_magnitude", "si_unit": "$1$", "validation": "`smallest_magnitude` or `target_magnitude`", "meaning": "SLEPc eigenvalue sorting criterion", "backend_support": "FEM modal lane", "problem_ir": "`study.fem_solver_policy.target_spectrum`"},
