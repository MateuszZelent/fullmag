{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [
      ".next/**",
      ".next-audit/**"
    ],
    "overrides": [
      {
        "files": ["dev-server.mjs"],
        "rules": ["react-doctor/local-rpc-native-bridge-risk"]
      },
      {
        "files": ["package.json"],
        "rules": ["react-doctor/no-vulnerable-react-server-components"]
      },
      {
        "files": ["src/kernel/layout/AppMenuBar.tsx"],
        "rules": ["react-doctor/effect-needs-cleanup"]
      },
      {
        "files": ["src/kernel/realtime/RealtimeInvalidationBridge.ts"],
        "rules": ["react-doctor/js-set-map-lookups"]
      },
      {
        "files": [
          "src/modules/footer/TransportLogTable.tsx",
          "src/modules/inspector/panels/mesh-details/MeshPolicyComparisonSection.tsx",
          "src/modules/inspector/panels/mesh-details/MeshQualityGatesSection.tsx"
        ],
        "rules": ["react-doctor/prefer-tag-over-role"]
      },
      {
        "files": ["src/shared/ui/Slider.tsx"],
        "rules": ["react-doctor/no-array-index-as-key"]
      },
      {
        "files": ["src/modules/viewport-3d/viewport3dResources.ts"],
        "rules": ["react-doctor/request-body-mass-assignment"]
      },
      {
        "files": [
          "src/modules/explorer/ExplorerTreeView.tsx",
          "src/modules/inspector/InspectorDirtySelectionGuard.tsx",
          "src/modules/inspector/InspectorEditSession.tsx",
          "src/modules/inspector/inspectorRegistry.tsx",
          "src/modules/inspector/panels/airbox/AirboxMeshParametersPanel.tsx",
          "src/modules/inspector/panels/FrequencyDomainCharts.tsx",
          "src/modules/inspector/panels/frequency-domain/FrequencyDomainResultInspectors.tsx",
          "src/modules/inspector/panels/HysteresisStageDraftFields.tsx",
          "src/modules/inspector/panels/MeshResourceView.tsx",
          "src/modules/inspector/panels/ModeVisualizationInspectorPanel.tsx",
          "src/modules/inspector/panels/StudyStageInspectorRouter.tsx",
          "src/modules/viewport-3d/layers/ClipPlaneLayer.tsx",
          "src/modules/viewport-3d/layers/Viewport3DScene.tsx"
        ],
        "rules": ["react-doctor/only-export-components"]
      },
      {
        "files": [
          "src/modules/viewport-3d/layers/**/*.tsx",
          "src/modules/viewport-3d/orientation/**/*.tsx"
        ],
        "rules": ["react/no-unknown-property"]
      },
      {
        "files": ["src/modules/viewport-3d/layers/CameraControls.tsx"],
        "rules": ["react-doctor/client-passive-event-listeners"]
      },
      {
        "files": ["src/modules/viewport-3d/viewport3dFieldMapping.ts"],
        "rules": ["react-doctor/async-await-in-loop"]
      },
      {
        "files": [
          "src/modules/viewport-3d/field-colors/viewport3dFieldColorBuildModel.ts"
        ],
        "rules": ["react-doctor/async-await-in-loop"]
      },
      {
        "files": ["src/kernel/api/ControlRoomApi.ts"],
        "rules": ["react-doctor/async-await-in-loop"]
      },
      {
        "files": ["src/kernel/api/ControlRoomApi.test.ts"],
        "rules": ["react-doctor/server-sequential-independent-await"]
      },
      {
        "files": ["src/kernel/api/generated/openapi-v2-types.ts"],
        "rules": ["knip/types"]
      },
      {
        "files": [
          "src/kernel/resources/geometryLifecycleResources.ts",
          "src/kernel/resources/studyRuntimeResources.ts"
        ],
        "rules": ["knip/exports"]
      },
      {
        "files": [
          "src/shared/ui/ContextMenu.tsx",
          "src/shared/ui/Dialog.tsx",
          "src/shared/ui/DropdownMenu.tsx"
        ],
        "rules": ["knip/exports"]
      }
    ]
  },
  "rules": {
    "react-doctor/no-giant-component": "off",
    "react-doctor/no-multi-comp": "off"
  }
}
