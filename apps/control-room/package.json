{
  "name": "@fullmag/control-room",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:binary": "node dev-server.mjs",
    "audit:idle-performance": "node scripts/audit-idle-performance.mjs",
    "audit:compute-performance": "node scripts/audit-compute-performance.mjs",
    "audit:viewport-2d-cross-section-performance": "node scripts/audit-viewport-2d-cross-section-performance.mjs",
    "audit:viewport-3d-memory-churn": "node scripts/audit-viewport-3d-memory-churn.mjs",
    "audit:viewport-3d-profile-switch": "node scripts/audit-viewport-3d-profile-switch.mjs",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "check:architecture-hygiene": "node scripts/check-architecture-hygiene.mjs",
    "check:api-hygiene": "node scripts/check-api-hygiene.mjs",
    "generate:api": "pnpm run generate:openapi-v2 && pnpm run generate:api-v2-types && pnpm run generate:api-v2-client",
    "generate:api-v2-client": "node scripts/generate-v2-client.mjs",
    "generate:api-v2-types": "openapi-typescript src/kernel/api/generated/openapi-v2.json --output src/kernel/api/generated/openapi-v2-types.ts",
    "generate:openapi-v2": "cargo run -p fullmag-api -- --print-openapi-v2 > src/kernel/api/generated/openapi-v2.json",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "smoke:cross-section-workflow": "node scripts/smoke-cross-section-workflow.mjs",
    "smoke:study-runtime-control": "node scripts/smoke-study-runtime-control.mjs",
    "screenshot:viewport-3d": "node scripts/screenshot-viewport-3d.mjs",
    "smoke:viewport-3d": "node scripts/smoke-viewport-3d.mjs",
    "verify:mesh-build-new-object": "node scripts/verify-mesh-build-new-object.mjs",
    "test": "vitest run",
    "typecheck": "next typegen . && tsc --noEmit",
    "smoke:compute-performance": "node scripts/smoke-compute-performance.mjs",
    "bench:compute-performance": "vitest run src/kernel/performance/computePerformanceMicrobench.test.ts --pool=threads"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.7.6",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "22.15.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.183.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.2.2",
    "typescript": "5.8.3",
    "vitest": "^4.1.5"
  }
}
