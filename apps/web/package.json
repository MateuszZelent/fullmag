{
  "name": "@fullmag/web",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); for (const dir of ['.next','out']) { fs.rmSync(dir, { recursive: true, force: true, maxRetries: 5, retryDelay: 120 }); }\"",
    "dev": "node dev-server.mjs --hostname 0.0.0.0 --port 3001",
    "generate:api": "npm run generate:openapi && npm run generate:api-types",
    "generate:openapi": "cargo run -p fullmag-api -- --print-openapi > src/api/generated/openapi.json",
    "generate:api-types": "openapi-typescript src/api/generated/openapi.json --output src/api/generated/openapi-types.ts",
    "typegen": "next typegen .",
    "build": "npm run clean && next build",
    "start": "node dev-server.mjs --hostname 0.0.0.0 --port 3001 --static-root out",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:quantity-api-gates": "vitest run src/api/client/modules/__tests__/FieldsModule.test.ts src/hooks/resources/__tests__/useFieldSlice2D.test.ts features/session-runtime/hooks/__tests__/useDataPlaneBridge.test.ts components/runs/control-room/__tests__/viewportLayers.test.ts components/runs/control-room/__tests__/viewportSelection.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/postcss": "^4.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "flexlayout-react": "^0.8.19",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "nanoid": "^5.1.9",
    "next": "^15.5.14",
    "openapi-fetch": "^0.17.0",
    "plotly.js": "^3.4.0",
    "postcss": "^8.5.8",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-plotly.js": "^2.6.0",
    "react-resizable-panels": "^4.7.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.183.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/plotly.js": "^3.0.10",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@types/react-plotly.js": "^2.6.4",
    "@types/three": "^0.183.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.8.3",
    "vitest": "^4.1.5"
  }
}
