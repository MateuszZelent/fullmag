### Render Model Builder

```typescript
describe("buildViewport3DRenderModel", () => {
  it("returns empty model when adapter is null", () => {
    const model = buildViewport3DRenderModel(null, null, null, emptySelection, []);
    expect(model.objects).toHaveLength(0);
    expect(model.scalarField).toBeNull();
  });

  it("separates airbox from objects", () => {
    const objects = [{ id: "disk" }, { id: "air", isAirbox: true }];
    const adapter = createDomainAdapter(mockFemMeta(), mockTopology(), objects);
    const model = buildViewport3DRenderModel(adapter, null, null, emptySelection, objects);
    expect(model.objects).toHaveLength(1);         // only disk
    expect(model.objects[0].objectId).toBe("disk");
    expect(model.airbox).not.toBeNull();
  });

  it("quantity switch does NOT change topology revision", () => {
    const adapter = createDomainAdapter(mockFdmMeta(), null, []);
    const model1 = buildViewport3DRenderModel(adapter, fieldA, vizState, sel, objs);
    const model2 = buildViewport3DRenderModel(adapter, fieldB, vizState, sel, objs);
    // Geometry reference is the same
    expect(model1.objects[0].geometry).toBe(model2.objects[0].geometry);
    // But scalar field changed
    expect(model1.scalarField?.quantityId).not.toBe(model2.scalarField?.quantityId);
  });
});
```

### Glyph Sampling

```typescript
describe("subsampleGlyphs", () => {
  it("returns all glyphs when count <= budget", () => {
    const vectors = mockVectors(100);
    const result = subsampleGlyphs(vectors, 100);
    expect(result.sampledCount).toBe(100);
  });

  it("reduces glyph count to budget", () => {
    const vectors = mockVectors(10000);
    const result = subsampleGlyphs(vectors, 500);
    expect(result.sampledCount).toBeLessThanOrEqual(500);
  });

  it("preserves direction and magnitude proportions", () => {
    const vectors = mockVectors(1000);
    const result = subsampleGlyphs(vectors, 100);
    // Spot-check: sampled entries match source entries
    expect(result.directions.length).toBe(result.sampledCount * 3);
    expect(result.magnitudes.length).toBe(result.sampledCount);
  });
});
```

### LOD Strategy

```typescript
describe("lodStrategy", () => {
  it("returns full render for small grids", () => {
    const strategy = computeLodStrategy(50000);
    expect(strategy.meshStride).toBe(1);
    expect(strategy.glyphBudget).toBeGreaterThan(1000);
  });

  it("reduces stride for large grids", () => {
    const strategy = computeLodStrategy(5000000);
    expect(strategy.meshStride).toBeGreaterThan(1);
  });

  it("uses memory_saver for very large grids", () => {
    const strategy = computeLodStrategy(20000000);
    expect(strategy.samplingProfile).toBe("memory_saver");
  });
});
```

### Viewport Store

```typescript
describe("viewport3DStore", () => {
  it("setGridLayout updates panes to match preset", () => {
    const { result } = renderHook(() => useViewport3DStore());
    act(() => result.current.setGridLayout("quad"));
    expect(result.current.panes).toHaveLength(4);
    expect(result.current.panes[0].id).toBe("tl");
  });

  it("togglePaneLayer toggles individual layer", () => {
    const { result } = renderHook(() => useViewport3DStore());
    act(() => result.current.togglePaneLayer("main", "vectorGlyphs"));
    expect(result.current.panes[0].layers.vectorGlyphs).toBe(false);
  });

  it("camera change is reflected in all pane reads", () => {
    const { result } = renderHook(() => useViewport3DStore());
    act(() => result.current.setCamera({ position: [1, 2, 3] }));
    expect(result.current.camera.position).toEqual([1, 2, 3]);
  });
});
```

