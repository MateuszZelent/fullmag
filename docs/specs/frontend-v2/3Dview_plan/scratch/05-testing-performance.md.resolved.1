# 05 — Testing, Performance, and Quality Gates

## 1. Test Tiers

| Tier | What | How | Gate |
|---|---|---|---|
| **Unit** | Adapters, geometry builders, render model, store, colormap, glyph sampling, LOD | Vitest, no WebGL | Every PR |
| **Integration** | Resource hook → adapter → render model flow, pane config updates | Vitest, mocked API | Every PR |
| **R3F render** | Layer components mount/unmount, invalidate on prop change | `@react-three/test-renderer` | Every PR |
| **Memory stress** | Resource leaks across 3D↔2D switches, quantity cycles, layout changes | Vitest + disposal counters | Weekly |
| **Visual** | Screenshot diff of rendered scenes | Playwright + canvas snapshot | Pre-release |

## 2. Unit Tests

### Cell Geometry Builders

```typescript
describe("buildCuboidGeometry", () => {
  it("produces correct cell count from grid shape", () => {
    const grid = { shape: [4, 4, 2], origin: [0, 0, 0], spacing: [5e-9, 5e-9, 5e-9] };
    const result = buildCuboidGeometry(grid);
    expect(result.kind).toBe("instanced-cuboids");
    expect(result.cellCount).toBe(32);
    expect(result.instanceMatrices.length).toBe(32 * 16);
  });

  it("cell centers are at correct positions", () => {
    const grid = { shape: [2, 1, 1], origin: [0, 0, 0], spacing: [10, 10, 10] };
    const result = buildCuboidGeometry(grid);
    expect(result.cellCenters[0]).toBe(5);   // first cell center x
    expect(result.cellCenters[3]).toBe(15);  // second cell center x
  });
});

describe("buildTetBoundaryGeometry", () => {
  it("converts Float64 positions to Float32", () => {
    const decoded = mockDecodedTopology();
    const result = buildTetBoundaryGeometry(decoded);
    expect(result.kind).toBe("tet-boundary");
    const posAttr = result.geometry.getAttribute("position");
    expect(posAttr.array).toBeInstanceOf(Float32Array);
  });

  it("computes normals", () => {
    const decoded = mockDecodedTopology();
    const result = buildTetBoundaryGeometry(decoded);
    expect(result.geometry.getAttribute("normal")).not.toBeNull();
  });

  it("preserves element markers", () => {
    const decoded = mockDecodedTopology({ elementCount: 10 });
    const result = buildTetBoundaryGeometry(decoded);
    expect(result.elementMarkers.length).toBe(10);
  });
});
```

### Domain Adapters

```typescript
describe("FdmDomainAdapter", () => {
  it("returns instanced-cuboids geometry", () => {
    const adapter = new FdmDomainAdapter(mockFdmMeta(), mockObjects());
    const geo = adapter.buildCellGeometry();
    expect(geo.kind).toBe("instanced-cuboids");
  });

  it("bounds match meta", () => {
    const meta = mockFdmMeta();
    const adapter = new FdmDomainAdapter(meta, []);
    expect(adapter.getBounds()).toBe(meta.bounds);
  });
});

describe("FemDomainAdapter", () => {
  it("returns tet-boundary geometry", () => {
    const adapter = new FemDomainAdapter(mockFemMeta(), mockDecodedTopology(), mockObjects());
    const geo = adapter.buildCellGeometry();
    expect(geo.kind).toBe("tet-boundary");
  });

  it("maps element markers to objects", () => {
    const objects = [{ id: "disk", name: "Disk" }, { id: "air", name: "Airbox", isAirbox: true }];
    const adapter = new FemDomainAdapter(mockFemMeta(), mockDecodedTopology(), objects);
    const mapping = adapter.getObjectMapping();
    expect(mapping.get(0)).toBe("disk");
    expect(mapping.get(1)).toBe("air");
  });

  it("identifies airbox markers", () => {
    const objects = [{ id: "disk" }, { id: "air", isAirbox: true }];
    const adapter = new FemDomainAdapter(mockFemMeta(), mockDecodedTopology(), objects);
    const markers = adapter.getAirboxMarkers();
    expect(markers.has(1)).toBe(true);
    expect(markers.has(0)).toBe(false);
  });
});

describe("createDomainAdapter", () => {
  it("returns FdmDomainAdapter for fdm discretization", () => {
    const adapter = createDomainAdapter({ ...mockMeta(), discretization: "fdm" }, null, []);
    expect(adapter.discretization).toBe("fdm");
  });

  it("returns FemDomainAdapter for fem discretization", () => {
    const adapter = createDomainAdapter({ ...mockMeta(), discretization: "fem" }, mockTopology(), []);
    expect(adapter.discretization).toBe("fem");
  });

  it("throws for fem without topology", () => {
    expect(() => createDomainAdapter({ ...mockMeta(), discretization: "fem" }, null, [])).toThrow();
  });
});
