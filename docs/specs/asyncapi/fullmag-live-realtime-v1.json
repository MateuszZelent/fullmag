{
  "asyncapi": "2.6.0",
  "info": {
    "title": "Fullmag Live Realtime API",
    "version": "1.0.0",
    "description": "Draft AsyncAPI contract for the canonical Fullmag realtime websocket. HTTP resources remain the source of truth for heavy data; the websocket carries invalidations, lifecycle notifications, and lightweight scalar telemetry."
  },
  "defaultContentType": "application/json",
  "servers": {
    "local": {
      "url": "localhost:8081",
      "protocol": "ws",
      "description": "Local Fullmag API server"
    }
  },
  "channels": {
    "/v2/sessions/current/events/ws": {
      "description": "Canonical realtime websocket for the current live workspace. Clients reconnect with `after_seq` and must offer `Sec-WebSocket-Protocol: fullmag.live.v1`.",
      "subscribe": {
        "operationId": "subscribeCurrentLiveRealtime",
        "summary": "Receive low-latency resource invalidation and lifecycle events",
        "message": {
          "oneOf": [
            { "$ref": "#/components/messages/HelloEvent" },
            { "$ref": "#/components/messages/HeartbeatEvent" },
            { "$ref": "#/components/messages/ResourceBatchChangedEvent" },
            { "$ref": "#/components/messages/ScalarSampleEvent" },
            { "$ref": "#/components/messages/ResyncRequiredEvent" }
          ]
        }
      },
      "bindings": {
        "ws": {
          "method": "GET",
          "query": {
            "type": "object",
            "properties": {
              "after_seq": {
                "type": "integer",
                "minimum": 0,
                "description": "Resume strictly after this last processed event sequence number."
              }
            }
          },
          "headers": {
            "type": "object",
            "required": ["Sec-WebSocket-Protocol"],
            "properties": {
              "Sec-WebSocket-Protocol": {
                "type": "string",
                "enum": ["fullmag.live.v1"]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "messages": {
      "HelloEvent": {
        "name": "hello",
        "payload": { "$ref": "#/components/schemas/HelloEvent" }
      },
      "HeartbeatEvent": {
        "name": "heartbeat",
        "payload": { "$ref": "#/components/schemas/HeartbeatEvent" }
      },
      "ResourceBatchChangedEvent": {
        "name": "resource.batch_changed",
        "payload": { "$ref": "#/components/schemas/ResourceBatchChangedEvent" }
      },
      "ScalarSampleEvent": {
        "name": "scalar.sample",
        "payload": { "$ref": "#/components/schemas/ScalarSampleEvent" }
      },
      "ResyncRequiredEvent": {
        "name": "resync.required",
        "payload": { "$ref": "#/components/schemas/ResyncRequiredEvent" }
      }
    },
    "schemas": {
      "EnvelopeBase": {
        "type": "object",
        "required": ["type", "seq", "ts", "session_id", "contract_version", "payload"],
        "properties": {
          "type": { "type": "string" },
          "seq": { "type": "integer", "minimum": 0 },
          "ts": { "type": "string", "format": "date-time" },
          "session_id": { "type": "string" },
          "run_id": { "type": ["string", "null"] },
          "contract_version": { "type": "string", "enum": ["1.0.0"] },
          "payload": { "type": "object" }
        }
      },
      "RealtimeResourceRevisionMap": {
        "type": "object",
        "required": [
          "topology_revision",
          "field_catalog_revision",
          "field_revision",
          "slice_revision",
          "artifact_revision",
          "command_completion_revision",
          "fields_revision",
          "scalars_revision",
          "domain_generation_id",
          "artifacts_revision",
          "engine_log_revision",
          "solver_profile_revision",
          "display_revision",
          "workspace_revision",
          "mesh_revision",
          "mesh_build_revision",
          "region_membership_revision",
          "commands_revision",
          "stages_revision",
          "simulation_preparation_revision",
          "visualization_state_revision"
        ],
        "properties": {
          "topology_revision": { "type": "integer", "minimum": 0 },
          "field_catalog_revision": { "type": "integer", "minimum": 0 },
          "field_revision": { "type": "integer", "minimum": 0 },
          "field_quantity_revisions": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 },
            "description": "Optional per-quantity field sample revision map used to narrow realtime invalidation for field samples."
          },
          "slice_revision": { "type": "integer", "minimum": 0 },
          "artifact_revision": { "type": "integer", "minimum": 0 },
          "command_completion_revision": { "type": "integer", "minimum": 0 },
          "fields_revision": { "type": "integer", "minimum": 0 },
          "scalars_revision": { "type": "integer", "minimum": 0 },
          "domain_generation_id": { "type": "string", "pattern": "^[0-9]+$" },
          "artifacts_revision": { "type": "integer", "minimum": 0 },
          "engine_log_revision": { "type": "integer", "minimum": 0 },
          "solver_profile_revision": { "type": "integer", "minimum": 0 },
          "display_revision": { "type": "integer", "minimum": 0 },
          "workspace_revision": { "type": "integer", "minimum": 0 },
          "mesh_revision": { "type": "integer", "minimum": 0 },
          "mesh_build_revision": { "type": "integer", "minimum": 0 },
          "region_membership_revision": { "type": "integer", "minimum": 0 },
          "commands_revision": { "type": "integer", "minimum": 0 },
          "stages_revision": { "type": "integer", "minimum": 0 },
          "simulation_preparation_revision": { "type": "integer", "minimum": 0 },
          "scene_revision": { "type": ["integer", "null"], "minimum": 0 },
          "visualization_state_revision": { "type": "integer", "minimum": 0 }
        }
      },
      "RealtimeResourceChange": {
        "type": "object",
        "required": ["resource", "revision"],
        "properties": {
          "resource": {
            "type": "string",
            "enum": [
              "display",
              "fields",
              "scalars",
              "domain",
              "artifacts",
              "logs",
              "diagnostics",
              "workspace",
              "mesh",
              "mesh_builds",
              "commands",
              "stages",
              "simulation",
              "scene_document",
              "visualization_state",
              "visualization_client_acks"
            ]
          },
          "revision": { "type": "integer", "minimum": 0 },
          "resource_id": { "type": ["string", "null"] },
          "quantity_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional canonical quantity IDs affected by a field-sample change."
          },
          "broad": {
            "type": "boolean",
            "description": "True when clients must treat the change as a broad family invalidation even if quantity IDs are absent or partial."
          },
          "domain_generation_id": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
          "recommended_fetch": { "type": ["string", "null"] }
        }
      },
      "RealtimeCommunicationPolicy": {
        "type": "object",
        "required": [
          "resource_batch_changed_enabled",
          "scalar_sample_enabled",
          "field_samples_enabled",
          "scalar_table_rows_enabled",
          "lifecycle_events_enabled",
          "diagnostics_enabled",
          "heartbeat_enabled",
          "visualization_client_acks_enabled",
          "ws_replay_capacity",
          "ws_heartbeat_ms",
          "ws_reconnect_ms",
          "lifecycle_coalesce_ms",
          "table_rows_min_refetch_ms",
          "field_sample_publish_ms",
          "scalar_telemetry_publish_ms",
          "diagnostics_summary_ms",
          "status_refresh_ms",
          "error_retry_ms"
        ],
        "properties": {
          "resource_batch_changed_enabled": { "type": "boolean", "default": true },
          "scalar_sample_enabled": { "type": "boolean", "default": true },
          "field_samples_enabled": { "type": "boolean", "default": true },
          "scalar_table_rows_enabled": { "type": "boolean", "default": true },
          "lifecycle_events_enabled": { "type": "boolean", "default": true },
          "diagnostics_enabled": { "type": "boolean", "default": true },
          "heartbeat_enabled": { "type": "boolean", "default": true },
          "visualization_client_acks_enabled": { "type": "boolean", "default": true },
          "ws_replay_capacity": { "type": "integer", "minimum": 1 },
          "ws_heartbeat_ms": { "type": "integer", "minimum": 1 },
          "ws_reconnect_ms": { "type": "integer", "minimum": 1, "default": 5000 },
          "lifecycle_coalesce_ms": { "type": "integer", "minimum": 0, "default": 250 },
          "table_rows_min_refetch_ms": { "type": "integer", "minimum": 1, "default": 1000 },
          "field_sample_publish_ms": { "type": "integer", "minimum": 1, "default": 2000 },
          "scalar_telemetry_publish_ms": { "type": "integer", "minimum": 1, "default": 200 },
          "diagnostics_summary_ms": { "type": "integer", "minimum": 1 },
          "status_refresh_ms": { "type": "integer", "minimum": 1, "default": 5000 },
          "error_retry_ms": { "type": "integer", "minimum": 1 }
        }
      },
      "HelloEvent": {
        "allOf": [
          { "$ref": "#/components/schemas/EnvelopeBase" },
          {
            "type": "object",
            "properties": {
              "type": { "const": "hello" },
              "payload": {
                "type": "object",
                "required": [
                  "server_time",
                  "replay_available_after_seq",
                  "current_seq",
                  "resource_revisions",
                  "communication_policy"
                ],
                "properties": {
                  "server_time": { "type": "string", "format": "date-time" },
                  "replay_available_after_seq": { "type": "integer", "minimum": 0 },
                  "current_seq": { "type": "integer", "minimum": 0 },
                  "resource_revisions": {
                    "$ref": "#/components/schemas/RealtimeResourceRevisionMap"
                  },
                  "communication_policy": {
                    "$ref": "#/components/schemas/RealtimeCommunicationPolicy"
                  }
                }
              }
            }
          }
        ]
      },
      "HeartbeatEvent": {
        "allOf": [
          { "$ref": "#/components/schemas/EnvelopeBase" },
          {
            "type": "object",
            "properties": {
              "type": { "const": "heartbeat" },
              "payload": {
                "type": "object",
                "required": ["current_seq"],
                "properties": {
                  "current_seq": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        ]
      },
      "ResourceBatchChangedEvent": {
        "allOf": [
          { "$ref": "#/components/schemas/EnvelopeBase" },
          {
            "type": "object",
            "properties": {
              "type": { "const": "resource.batch_changed" },
              "payload": {
                "type": "object",
                "required": ["changes", "coalesced", "window_ms"],
                "properties": {
                  "changes": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/RealtimeResourceChange" }
                  },
                  "coalesced": { "type": "boolean" },
                  "window_ms": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        ]
      },
      "ScalarSampleEvent": {
        "allOf": [
          { "$ref": "#/components/schemas/EnvelopeBase" },
          {
            "type": "object",
            "properties": {
              "type": { "const": "scalar.sample" },
              "payload": {
                "type": "object",
                "required": ["revision", "row"],
                "properties": {
                  "revision": { "type": "integer", "minimum": 0 },
                  "row": {
                    "type": "object",
                    "required": ["step", "time"],
                    "additionalProperties": { "type": "number" },
                    "properties": {
                      "step": { "type": "integer", "minimum": 0 },
                      "time": { "type": "number" }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "ResyncRequiredEvent": {
        "allOf": [
          { "$ref": "#/components/schemas/EnvelopeBase" },
          {
            "type": "object",
            "properties": {
              "type": { "const": "resync.required" },
              "payload": {
                "type": "object",
                "required": ["reason", "replay_available_after_seq"],
                "properties": {
                  "reason": { "type": "string", "enum": ["sequence_gap", "replay_unavailable"] },
                  "expected_after": { "type": ["integer", "null"], "minimum": 0 },
                  "replay_available_after_seq": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        ]
      }
    }
  }
}
