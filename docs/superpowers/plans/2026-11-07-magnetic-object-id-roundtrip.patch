+        wire["geometries"][0]["object_id"] = serde_json::json!("immutable-A");
+        let mut second = wire["geometries"][0].clone();
+        second["name"] = serde_json::json!("second");
+        wire["geometries"].as_array_mut().unwrap().push(second);
